<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="2200" height="950" viewBox="0 0 2200 950" role="img" aria-labelledby="title desc">
  <title id="title">The adapted Transcriptome Transformer</title>
  <desc id="desc">A GROUSE-inspired editorial diagram of the PPI-initialized adapted Transcriptome Transformer. A whole-blood patient-by-gene expression matrix branches into PPI-informed shared gene embeddings and patient-specific TUPE. TUPE enters self-attention inside one shared multitask encoder, whose pooled representation feeds three binary classification heads.</desc>

  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8.2" refY="5" orient="auto" markerUnits="strokeWidth">
      <path d="M1.2 1.2 L8.2 5 L1.2 8.8" fill="none" stroke="#26272A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="arrow-red" markerWidth="10" markerHeight="10" refX="8.2" refY="5" orient="auto" markerUnits="strokeWidth">
      <path d="M1.2 1.2 L8.2 5 L1.2 8.8" fill="none" stroke="#822433" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <marker id="arrow-blue" markerWidth="10" markerHeight="10" refX="8.2" refY="5" orient="auto" markerUnits="strokeWidth">
      <path d="M1.2 1.2 L8.2 5 L1.2 8.8" fill="none" stroke="#24768B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
    <linearGradient id="attn-field" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E6F1F4"/>
      <stop offset="1" stop-color="#F5E9EC"/>
    </linearGradient>
    <linearGradient id="tupe-field" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F9F0F2"/>
      <stop offset="0.55" stop-color="#E8C6CE"/>
      <stop offset="1" stop-color="#F5E6E9"/>
    </linearGradient>
    <filter id="paper-lift" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#202124" flood-opacity="0.08"/>
    </filter>
    <style>
      text { font-family: Arial, Helvetica, sans-serif; fill: #26272A; }
      .title { font-size: 49px; font-weight: 700; letter-spacing: -0.9px; }
      .kicker { font-size: 19px; font-weight: 700; letter-spacing: 3px; fill: #822433; }
      .callout { font-size: 22px; font-weight: 500; }
      .callout-num { font-size: 25px; font-weight: 700; }
      .strong { font-weight: 700; fill: #822433; }
      .section { font-size: 17px; font-weight: 700; letter-spacing: 1.25px; }
      .section-blue { font-size: 17px; font-weight: 700; letter-spacing: 1.25px; fill: #24768B; }
      .section-red { font-size: 17px; font-weight: 700; letter-spacing: 1.25px; fill: #822433; }
      .label { font-size: 21px; font-weight: 700; }
      .small { font-size: 15px; font-weight: 500; fill: #676B6E; }
      .micro { font-size: 12px; font-weight: 700; letter-spacing: 0.7px; }
      .gene { font-family: Georgia, "Times New Roman", serif; font-size: 13px; font-style: italic; font-weight: 700; }
      .math { font-family: Georgia, "Times New Roman", serif; font-style: italic; }
      .flow { fill: none; stroke: #26272A; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; marker-end: url(#arrow); }
      .blue-flow { fill: none; stroke: #24768B; stroke-width: 3.1; stroke-linecap: round; stroke-linejoin: round; marker-end: url(#arrow-blue); }
      .red-flow { fill: none; stroke: #822433; stroke-width: 3.1; stroke-linecap: round; stroke-linejoin: round; marker-end: url(#arrow-red); }
      .leader { fill: none; stroke: #26272A; stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round; marker-end: url(#arrow); }
      .quiet-edge { fill: none; stroke: #83B4C2; stroke-width: 2; stroke-linecap: round; opacity: 0.72; }
      .patient-edge { fill: none; stroke: #822433; stroke-linecap: round; opacity: 0.9; marker-end: url(#arrow-red); }
    </style>
  </defs>

  <rect width="2200" height="950" fill="#FCFBF7"/>
  <line x1="50" y1="27" x2="2150" y2="27" stroke="#D8D7D2" stroke-width="2" stroke-dasharray="2 8"/>
  <text x="52" y="62" class="kicker">METHOD</text>
  <text x="1100" y="66" text-anchor="middle" class="title">The adapted Transcriptome Transformer</text>

  <!-- Four short GROUSE-style explanations -->
  <g>
    <text x="55" y="115" class="callout-num">1)</text>
    <text x="91" y="115" class="callout">
      <tspan class="strong">Start from whole-blood expression:</tspan>
      <tspan x="91" dy="31">patients × genes in one aligned matrix.</tspan>
    </text>
    <path d="M300 161 C326 229 294 300 272 410" class="leader"/>

    <text x="505" y="104" class="callout-num">2)</text>
    <text x="541" y="104" class="callout">
      <tspan>Use </tspan><tspan class="strong" dx="5">PPI-informed node2vec</tspan>
      <tspan x="541" dy="31">to initialize </tspan><tspan class="strong" dx="5">shared gene embeddings;</tspan>
      <tspan x="541" dy="31">keep expression patient-specific.</tspan>
    </text>

    <text x="1100" y="108" class="callout-num">3)</text>
    <text x="1136" y="108" class="callout">
      <tspan>Inject </tspan><tspan class="strong" dx="5">TUPE only into self-attention</tspan>
      <tspan x="1136" dy="31">inside one shared TxT encoder.</tspan>
    </text>
    <path d="M1375 149 C1372 228 1240 285 1162 323" class="leader"/>

    <text x="1710" y="112" class="callout-num">4)</text>
    <text x="1746" y="112" class="callout">
      <tspan>Pool one patient representation, then</tspan>
      <tspan x="1746" dy="31">route it to </tspan><tspan class="strong" dx="5">multiple classification heads.</tspan>
    </text>
    <path d="M1830 168 C1805 260 1778 367 1808 509" class="leader"/>
  </g>

  <!-- True LaTeX formulas, visually secondary -->
  <g>
    <image x="735" y="220" width="410" height="76" preserveAspectRatio="xMidYMid meet" href="data:image/svg+xml;base64,__FORMULA_BIAS__"/>
    <text x="940" y="308" text-anchor="middle" class="small" fill="#822433">patient-specific TUPE bias</text>
    <image x="1210" y="230" width="590" height="86" preserveAspectRatio="xMidYMid meet" href="data:image/svg+xml;base64,__FORMULA_ATTENTION__"/>
    <text x="1505" y="326" text-anchor="middle" class="small" fill="#24768B">content score + TUPE, before row-softmax</text>
  </g>

  <!-- 1. Whole-blood gene expression matrix -->
  <g>
    <text x="205" y="402" text-anchor="middle" class="section">WHOLE-BLOOD EXPRESSION</text>
    <text x="205" y="426" text-anchor="middle" class="small">one matrix · patients × genes</text>

    <g transform="translate(84 462)" filter="url(#paper-lift)">
      <rect x="0" y="0" width="250" height="242" rx="8" fill="#FFFFFF" stroke="#26272A" stroke-width="2"/>
      <g stroke="#FFFFFF" stroke-width="3">
        <g fill="#C8DFE6"><rect x="18" y="17" width="23" height="23"/><rect x="44" y="17" width="23" height="23"/><rect x="70" y="17" width="23" height="23"/><rect x="96" y="17" width="23" height="23"/><rect x="122" y="17" width="23" height="23"/><rect x="148" y="17" width="23" height="23"/><rect x="174" y="17" width="23" height="23"/><rect x="200" y="17" width="23" height="23"/></g>
        <g fill="#90BDC9"><rect x="18" y="43" width="23" height="23"/><rect x="44" y="43" width="23" height="23" fill="#F0D39F"/><rect x="70" y="43" width="23" height="23"/><rect x="96" y="43" width="23" height="23" fill="#D7E8EC"/><rect x="122" y="43" width="23" height="23"/><rect x="148" y="43" width="23" height="23" fill="#E6C2CB"/><rect x="174" y="43" width="23" height="23"/><rect x="200" y="43" width="23" height="23"/></g>
        <g fill="#DCEBEF"><rect x="18" y="69" width="23" height="23"/><rect x="44" y="69" width="23" height="23" fill="#E9C9D0"/><rect x="70" y="69" width="23" height="23"/><rect x="96" y="69" width="23" height="23" fill="#F0D39F"/><rect x="122" y="69" width="23" height="23"/><rect x="148" y="69" width="23" height="23"/><rect x="174" y="69" width="23" height="23" fill="#79ACBC"/><rect x="200" y="69" width="23" height="23"/></g>
        <g fill="#D8A7B3"><rect x="18" y="95" width="23" height="23"/><rect x="44" y="95" width="23" height="23" fill="#822433"/><rect x="70" y="95" width="23" height="23" fill="#E9C9D0"/><rect x="96" y="95" width="23" height="23" fill="#9B3C51"/><rect x="122" y="95" width="23" height="23" fill="#F0D39F"/><rect x="148" y="95" width="23" height="23" fill="#B86175"/><rect x="174" y="95" width="23" height="23" fill="#E6BAC4"/><rect x="200" y="95" width="23" height="23" fill="#9E4054"/></g>
        <g fill="#B8D6DE"><rect x="18" y="121" width="23" height="23"/><rect x="44" y="121" width="23" height="23"/><rect x="70" y="121" width="23" height="23" fill="#E9C9D0"/><rect x="96" y="121" width="23" height="23"/><rect x="122" y="121" width="23" height="23" fill="#F0D39F"/><rect x="148" y="121" width="23" height="23"/><rect x="174" y="121" width="23" height="23"/><rect x="200" y="121" width="23" height="23"/></g>
        <g fill="#DCEBEF"><rect x="18" y="147" width="23" height="23"/><rect x="44" y="147" width="23" height="23" fill="#82B1BF"/><rect x="70" y="147" width="23" height="23"/><rect x="96" y="147" width="23" height="23"/><rect x="122" y="147" width="23" height="23" fill="#E8C4CD"/><rect x="148" y="147" width="23" height="23"/><rect x="174" y="147" width="23" height="23" fill="#F0D39F"/><rect x="200" y="147" width="23" height="23"/></g>
        <g fill="#9EC4CF"><rect x="18" y="173" width="23" height="23"/><rect x="44" y="173" width="23" height="23"/><rect x="70" y="173" width="23" height="23" fill="#F0D39F"/><rect x="96" y="173" width="23" height="23"/><rect x="122" y="173" width="23" height="23"/><rect x="148" y="173" width="23" height="23" fill="#E8C4CD"/><rect x="174" y="173" width="23" height="23"/><rect x="200" y="173" width="23" height="23"/></g>
      </g>
      <text x="125" y="228" text-anchor="middle" class="gene" font-size="15">X ∈ R<tspan baseline-shift="super" font-size="10">Ns×Ng</tspan></text>
    </g>
    <text x="205" y="733" text-anchor="middle" class="small">genes →</text>
    <text x="55" y="585" text-anchor="middle" class="small" transform="rotate(-90 55 585)">patients →</text>

    <!-- Two semantically distinct branches leave the matrix -->
    <path d="M334 583 C496 583 630 583 797 583" class="blue-flow"/>
    <text x="548" y="565" text-anchor="middle" class="micro" fill="#24768B">SHARED GENE ORDER</text>
    <path d="M334 557 C392 374 647 344 908 348" class="red-flow"/>
    <text x="540" y="355" text-anchor="middle" class="micro" fill="#822433">ONE PATIENT <tspan class="math">x</tspan><tspan baseline-shift="sub" font-family="Georgia" font-size="9">s</tspan></text>
  </g>

  <!-- 2A. External PPI initializes the embedding lane without being created by X -->
  <g>
    <text x="555" y="704" text-anchor="middle" class="section-blue">PPI INITIALIZATION</text>
    <circle cx="455" cy="790" r="68" fill="#EFF6F7"/>
    <g class="quiet-edge">
      <path d="M415 751 L459 728 L503 752 L515 797 L480 840 L430 828 Z"/>
      <path d="M415 751 L503 752 M459 728 L515 797 M415 751 L480 840 M430 828 L503 752"/>
    </g>
    <g stroke="#FFFFFF" stroke-width="2">
      <circle cx="415" cy="751" r="11" fill="#F69240"/><circle cx="459" cy="728" r="11" fill="#C79900"/>
      <circle cx="503" cy="752" r="11" fill="#00B3BE"/><circle cx="515" cy="797" r="11" fill="#D58A9A"/>
      <circle cx="480" cy="840" r="11" fill="#24768B"/><circle cx="430" cy="828" r="11" fill="#72A68E"/>
    </g>
    <text x="455" y="875" text-anchor="middle" class="small">external HIPPIE PPI</text>

    <path d="M525 790 H557" class="flow"/>
    <rect x="570" y="742" width="112" height="96" rx="22" fill="#F1D9DE" stroke="#822433" stroke-width="2"/>
    <text x="626" y="784" text-anchor="middle" class="micro">NODE2VEC</text>
    <text x="626" y="810" text-anchor="middle" class="small">offline</text>
    <text x="626" y="829" text-anchor="middle" class="small">initialization</text>

    <path d="M682 790 C730 790 757 724 808 655" class="flow"/>
    <rect x="695" y="714" width="148" height="30" rx="15" fill="#FCFBF7" stroke="#D7D6D1" stroke-width="1.3"/>
    <text x="769" y="734" text-anchor="middle" class="micro" fill="#24768B">INITIALIZE E</text>
    <text x="800" y="472" text-anchor="middle" class="section-blue">SHARED EMBEDDINGS</text>
    <g transform="translate(799 499)" filter="url(#paper-lift)">
      <rect x="24" y="0" width="66" height="128" rx="5" fill="#D7E9ED" stroke="#24768B" stroke-width="1.7"/>
      <rect x="16" y="9" width="66" height="128" rx="5" fill="#C8E0E6" stroke="#24768B" stroke-width="1.7"/>
      <rect x="8" y="18" width="66" height="128" rx="5" fill="#B5D5DE" stroke="#24768B" stroke-width="1.7"/>
      <rect x="0" y="27" width="66" height="128" rx="5" fill="#9EC6D1" stroke="#24768B" stroke-width="1.7"/>
      <g stroke="#FFFFFF" stroke-width="2"><path d="M11 48 H55 M11 68 H55 M11 88 H55 M11 108 H55 M11 128 H55"/></g>
    </g>
  </g>

  <!-- 2B. Patient expression becomes TUPE above the encoder -->
  <g>
    <rect x="916" y="318" width="260" height="100" rx="50" fill="url(#tupe-field)" stroke="#822433" stroke-width="2.4"/>
    <text x="1046" y="351" text-anchor="middle" class="section-red">PATIENT-SPECIFIC TUPE</text>
    <g stroke="#822433" stroke-linecap="round" opacity="0.72">
      <path d="M966 375 H1005" stroke-width="6"/><path d="M1022 375 H1117" stroke-width="11"/>
      <path d="M978 397 H1045" stroke-width="8"/><path d="M1064 397 H1127" stroke-width="5"/>
    </g>
  </g>

  <!-- 3. One shared multitask encoder. TUPE lands specifically in self-attention. -->
  <g>
    <rect x="905" y="468" width="724" height="290" rx="43" fill="#F7F7F4" stroke="#822433" stroke-width="2.4"/>
    <rect x="1137" y="449" width="354" height="32" fill="#FCFBF7"/>
    <text x="1314" y="472" text-anchor="middle" class="section">SHARED MULTITASK TxT ENCODER</text>

    <!-- embedding input -->
    <path d="M889 583 H947" class="flow"/>

    <!-- attention is the dominant internal visual -->
    <rect x="960" y="500" width="350" height="210" rx="39" fill="url(#attn-field)" stroke="#24768B" stroke-width="2.2"/>
    <text x="1135" y="529" text-anchor="middle" class="section-blue">SELF-ATTENTION</text>
    <g class="quiet-edge">
      <path d="M1020 579 C1050 540 1101 545 1135 568"/><path d="M1135 568 C1187 536 1240 555 1252 596"/>
      <path d="M1020 579 C1007 629 1040 672 1084 674"/><path d="M1065 625 C1110 591 1172 591 1211 625"/>
      <path d="M1135 568 C1123 611 1102 627 1065 625"/><path d="M1211 625 C1180 661 1136 677 1084 674"/>
    </g>
    <g class="patient-edge">
      <path d="M1020 579 C1091 571 1152 590 1211 625" stroke-width="7"/>
      <path d="M1135 568 C1185 564 1226 579 1252 596" stroke-width="4.5"/>
      <path d="M1211 625 C1164 662 1127 676 1084 674" stroke-width="7"/>
    </g>
    <g stroke="#26272A" stroke-width="2">
      <circle cx="1020" cy="579" r="19" fill="#B9D9E1"/><circle cx="1135" cy="568" r="19" fill="#E5C0C9"/>
      <circle cx="1252" cy="596" r="19" fill="#B9D9E1"/><circle cx="1065" cy="625" r="19" fill="#E5C0C9"/>
      <circle cx="1211" cy="625" r="19" fill="#B9D9E1"/><circle cx="1084" cy="674" r="19" fill="#B9D9E1"/>
    </g>
    <g class="gene" text-anchor="middle"><text x="1020" y="584">g₁</text><text x="1135" y="573">g₂</text><text x="1252" y="601">g₃</text><text x="1065" y="630">g₄</text><text x="1211" y="630">g₅</text><text x="1084" y="679">g₆</text></g>

    <!-- TUPE attaches at the attention logits, not at embeddings or values -->
    <path d="M1046 418 C1046 434 1086 436 1086 473" class="red-flow"/>
    <circle cx="1086" cy="490" r="17" fill="#FCFBF7" stroke="#822433" stroke-width="2"/>
    <text x="1086" y="498" text-anchor="middle" font-family="Georgia, serif" font-size="28" fill="#822433">+</text>

    <path d="M1310 605 H1353" class="flow"/>
    <rect x="1365" y="535" width="190" height="140" rx="28" fill="#D9EBEF" stroke="#24768B" stroke-width="2"/>
    <text x="1460" y="596" text-anchor="middle" class="label">GENE-WISE</text>
    <text x="1460" y="625" text-anchor="middle" class="label">UPDATE</text>
    <text x="1460" y="649" text-anchor="middle" class="small">shared across tasks</text>
  </g>

  <!-- 4. Pool once, then branch into three binary heads -->
  <g>
    <path d="M1629 605 H1673" class="flow"/>
    <g transform="translate(1680 500)">
      <rect x="0" y="0" width="34" height="31" rx="5" fill="#B8D8E1" stroke="#24768B" stroke-width="1.3"/>
      <rect x="0" y="38" width="34" height="31" rx="5" fill="#76AFC0" stroke="#24768B" stroke-width="1.3"/>
      <rect x="0" y="76" width="34" height="31" rx="5" fill="#E4BEC7" stroke="#822433" stroke-width="1.3"/>
      <rect x="0" y="114" width="34" height="31" rx="5" fill="#C9E0E7" stroke="#24768B" stroke-width="1.3"/>
      <rect x="0" y="152" width="34" height="31" rx="5" fill="#E4BEC7" stroke="#822433" stroke-width="1.3"/>
      <rect x="0" y="190" width="34" height="31" rx="5" fill="#76AFC0" stroke="#24768B" stroke-width="1.3"/>
    </g>
    <g fill="none" stroke="#72777A" stroke-width="1.5" opacity="0.8">
      <path d="M1718 516 C1753 524 1765 555 1779 584"/><path d="M1718 554 C1750 559 1766 575 1779 591"/>
      <path d="M1718 592 C1750 592 1765 596 1779 597"/><path d="M1718 630 C1750 627 1765 616 1779 605"/>
      <path d="M1718 668 C1750 656 1765 630 1779 612"/><path d="M1718 706 C1750 684 1765 650 1779 619"/>
    </g>
    <circle cx="1827" cy="602" r="51" fill="#C7DFD0" stroke="#517660" stroke-width="2.7"/>
    <text x="1827" y="615" text-anchor="middle" font-family="Georgia, serif" font-size="34" font-style="italic" font-weight="700">z<tspan baseline-shift="sub" font-size="21">s</tspan></text>
    <text x="1827" y="682" text-anchor="middle" class="small">MEAN POOL</text>

    <text x="2025" y="386" text-anchor="middle" class="section">MASK-AWARE BINARY HEADS</text>
    <path d="M1878 602 C1912 565 1935 506 1964 479" class="flow"/>
    <path d="M1878 602 H1964" class="flow"/>
    <path d="M1878 602 C1912 638 1935 697 1964 724" class="flow"/>

    <path d="M1974 442 C2044 429 2121 435 2160 450 L2156 513 C2100 526 2036 523 1975 509 Z" fill="#E5C0C9"/>
    <text x="1995" y="466" class="micro" fill="#822433">PRIMARY</text>
    <text x="1995" y="497" class="label" fill="#822433">AD–MCI</text>
    <circle cx="1992" cy="602" r="7" fill="#739784"/><text x="2012" y="610" class="label">AD–CTL</text>
    <circle cx="1992" cy="726" r="7" fill="#739784"/><text x="2012" y="734" class="label">MCI–CTL</text>
  </g>

</svg>
